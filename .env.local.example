# Sanity CMS Setup
NEXT_PUBLIC_SANITY_PROJECT_ID=""
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2024-01-01"

# Sanity Revalidation Webhook Secret (Optional)
REVALIDATE_SECRET=""

# Target email to receive contact form messages
CONTACT_TO_EMAIL=""

# -------------------------------------------------------------
# Email Provider Option 1: Brevo (Active if BREVO_API_KEY is set)
# -------------------------------------------------------------
BREVO_API_KEY=""
CONTACT_FROM_EMAIL="" # Must be a verified sender in Brevo (e.g. hello@devunomieta.xyz)
CONTACT_FROM_NAME="Joseph Unomieta Website"

# -------------------------------------------------------------
# Email Provider Option 2: Resend (Fallback if BREVO_API_KEY is unset)
# -------------------------------------------------------------
RESEND_API_KEY=""

# Base URL (for sitemap, RSS feed, social images)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
